@model FerreteriaWeb.Models.ProductoModel

@{
    ViewData["Title"] = "Detalle del Producto";
    var categoria = string.IsNullOrEmpty(Model.NombreCategoria) ? "General" : Model.NombreCategoria;
    var descripcion = string.IsNullOrWhiteSpace(Model.Descripcion) || Model.Descripcion.Contains("Prueba", StringComparison.OrdinalIgnoreCase)
        ? $"Categoría: {categoria}"
        : Model.Descripcion;
}

<section class="container-fluid py-5 px-0">
    <div class="product-detail-shell">
        <div class="row g-0">
            <div class="col-lg-5">
                <div class="product-detail-media">
                    <img src="~/img/Productos destacados/@Model.Imagen"
                         class="img-fluid product-image"
                         alt="@Model.Nombre" />
                </div>
            </div>
            <div class="col-lg-7">
                <div class="product-detail-content">
                    <span class="product-category">@categoria</span>
                    <h1>@Model.Nombre</h1>
                    <p class="lead">@descripcion</p>

                    <div class="detail-price">₡ @Model.Precio.ToString("N2")</div>

                    @if (Model.StockActual > 0)
                    {
                        <div class="detail-stock text-success">
                            <i class="bi bi-check-circle-fill"></i>
                            Disponible: @Model.StockActual unidades
                        </div>
                    }
                    else
                    {
                        <div class="detail-stock text-danger">
                            <i class="bi bi-x-circle-fill"></i>
                            Agotado
                        </div>
                    }

                    <form asp-controller="Carrito"
                          asp-action="Agregar"
                          method="post"
                          class="detail-actions">
                        <input type="hidden" name="id" value="@Model.IdProducto" />
                        <input type="hidden" id="cantidadHidden" name="cantidad" value="1" data-cantidad-hidden />

                        <div class="quantity-stepper detail-stepper" data-cantidad-control>
                            <button type="button" data-cantidad-btn="-1" aria-label="Restar cantidad">-</button>
                            <input type="number"
                                   id="cantidad"
                                   value="1"
                                   min="1"
                                   data-cantidad-input
                                   aria-label="Cantidad" />
                            <button type="button" data-cantidad-btn="1" aria-label="Sumar cantidad">+</button>
                        </div>

                        <button type="submit"
                                class="btn btn-warning btn-lg"
                                @(Model.StockActual <= 0 ? "disabled" : "")>
                            <i class="bi bi-cart-plus me-2"></i>Agregar al carrito
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-dark btn-lg">
                            Volver
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

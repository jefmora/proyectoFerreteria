@model List<FerreteriaWeb.Models.ProductoModel>

@{
    ViewData["Title"] = "Inicio";

    var productos = Model ?? new List<FerreteriaWeb.Models.ProductoModel>();
    var productosDestacados = productos.Take(8).ToList();
    var categorias = (ViewBag.Categorias as List<FerreteriaWeb.Models.CategoriaModel>) ?? new List<FerreteriaWeb.Models.CategoriaModel>();
    var categoryImages = new[] { "cat-1.jpg", "cat-2.jpg", "cat-3.jpg", "cat-4.jpg" };
}

<section class="hardware-hero">
    <div class="container-fluid px-xl-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="hero-kicker">Ferretería ProAva</span>
                <h1>Todo para construir, reparar y mantener su proyecto.</h1>
                <p>
                    Herramientas, materiales y asesoría técnica en un solo lugar. Compre rápido,
                    revise disponibilidad y agregue lo que ocupa al carrito sin complicarse.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-warning btn-lg fw-bold">
                        <i class="bi bi-bag-check me-2"></i>Ver productos
                    </a>
                    <a asp-controller="Contacto" asp-action="Crear" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-headset me-2"></i>Pedir asesoría
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-showcase">
                    <img src="~/img/offer-1.jpg" alt="Herramientas de ferretería" />
                    <div class="hero-offer">
                        <span>Oferta del mes</span>
                        <strong>20% menos</strong>
                        <small>en herramientas seleccionadas</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container-fluid px-xl-5 py-4">
    <div class="row g-3">
        <div class="col-lg-3 col-md-6">
            <div class="service-tile">
                <i class="bi bi-patch-check"></i>
                <div>
                    <h3>Calidad garantizada</h3>
                    <p>Productos resistentes para trabajo real.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="service-tile">
                <i class="bi bi-truck"></i>
                <div>
                    <h3>Entrega rápida</h3>
                    <p>Despacho ágil para no detener su obra.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="service-tile">
                <i class="bi bi-tools"></i>
                <div>
                    <h3>Inventario útil</h3>
                    <p>Herramientas, pintura, medición y más.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="service-tile">
                <i class="bi bi-person-check"></i>
                <div>
                    <h3>Asesoría experta</h3>
                    <p>Le ayudamos a escoger bien desde el inicio.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (categorias.Any())
{
    <section class="container-fluid px-xl-5 py-4">
        <div class="section-heading">
            <span>Catálogo</span>
            <h2>Categorías disponibles</h2>
        </div>
        <div class="row g-4">
            @for (var i = 0; i < categorias.Count; i++)
            {
                var categoria = categorias[i];
                var imageName = categoryImages[i % categoryImages.Length];

                <div class="col-lg-3 col-md-6">
                    <a class="category-card category-link"
                       asp-controller="Producto"
                       asp-action="Index"
                       asp-route-idCategoria="@categoria.IdCategoria"
                       asp-route-categoria="@categoria.Nombre">
                        <img src="~/img/Categorias/@imageName" alt="@categoria.Nombre" />
                        <div>
                            <h3>@categoria.Nombre</h3>
                            <p>@(string.IsNullOrWhiteSpace(categoria.Descripcion) ? "Ver productos de esta categoría." : categoria.Descripcion)</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

<section class="container-fluid px-xl-5 py-4">
    <div class="section-heading">
        <span>Más vendidos</span>
        <h2>Productos destacados</h2>
    </div>

    @if (!productosDestacados.Any())
    {
        <div class="empty-store">
            <i class="bi bi-box-seam"></i>
            <h3>No hay productos disponibles</h3>
            <p>Cuando se cargue el inventario, aparecerá en esta sección.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in productosDestacados)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <article class="product-card h-100">
                        <a asp-controller="Producto"
                           asp-action="Detalle"
                           asp-route-id="@item.IdProducto"
                           class="product-image-wrap">
                            <img src="~/img/Productos destacados/@item.Imagen"
                                 alt="@item.Nombre" />
                        </a>
                        <div class="product-card-body">
                            <span class="product-category">@(string.IsNullOrEmpty(item.NombreCategoria) ? "General" : item.NombreCategoria)</span>
                            <h3>@item.Nombre</h3>
                            <p class="product-description">Categoría: @(string.IsNullOrEmpty(item.NombreCategoria) ? "General" : item.NombreCategoria)</p>
                            <div class="product-meta">
                                <strong>₡ @item.Precio.ToString("N2")</strong>
                                @if (item.StockActual > 0)
                                {
                                    <span class="stock-badge in-stock">@item.StockActual en stock</span>
                                }
                                else
                                {
                                    <span class="stock-badge out-stock">Agotado</span>
                                }
                            </div>
                            <div class="product-actions">
                                <a asp-controller="Producto"
                                   asp-action="Detalle"
                                   asp-route-id="@item.IdProducto"
                                   class="btn btn-outline-dark">
                                    <i class="bi bi-eye me-1"></i>Ver
                                </a>
                                <form asp-controller="Carrito"
                                      asp-action="Agregar"
                                      method="post"
                                      class="add-cart-form">
                                    <input type="hidden" name="id" value="@item.IdProducto" />
                                    <input type="hidden" name="cantidad" value="1" data-cantidad-hidden />
                                    <div class="quantity-stepper" data-cantidad-control>
                                        <button type="button" data-cantidad-btn="-1" aria-label="Restar cantidad">-</button>
                                        <input type="number"
                                               value="1"
                                               min="1"
                                               data-cantidad-input
                                               aria-label="Cantidad" />
                                        <button type="button" data-cantidad-btn="1" aria-label="Sumar cantidad">+</button>
                                    </div>
                                    <button class="btn btn-warning fw-bold" @(item.StockActual <= 0 ? "disabled" : "")>
                                        <i class="bi bi-cart-plus me-1"></i>Agregar
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

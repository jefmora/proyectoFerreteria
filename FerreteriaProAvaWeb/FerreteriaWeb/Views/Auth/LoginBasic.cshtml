@model FerreteriaWeb.Models.UsuarioModel

@{
    ViewData["Title"] = "Login";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/page-auth.css">
    <link rel="stylesheet" href="~/css/core.css">
}

<section class="hardware-login">
    <div class="login-panel">
        <div class="login-copy">
            <span class="login-kicker">Ferretería ProAva</span>
            <h1>Bienvenido a Ferretería ProAva.</h1>
            <p>
                Ingrese para ver productos disponibles, hacer sus compras y recibir atención
                rápida para sus proyectos de construcción, reparación o mantenimiento.
            </p>
            <div class="login-benefits">
                <div><i class="bi bi-tools"></i> Productos de ferretería</div>
                <div><i class="bi bi-cart-check"></i> Compras rápidas</div>
                <div><i class="bi bi-headset"></i> Atención personalizada</div>
            </div>
        </div>

        <div class="login-card">
            <a href="/" class="login-brand">
                <span><i class="bi bi-tools"></i></span>
                <strong>FERRE PROAVA</strong>
            </a>

            <h2>Iniciar sesión</h2>
            <p>Ingrese sus datos para continuar con su compra.</p>

            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger text-center mb-4" role="alert">
                    @ViewBag.Mensaje
                </div>
            }

            <form id="formAuthentication" asp-controller="Auth" asp-action="LoginBasic" method="post">
                <div class="mb-3">
                    <label class="form-label" asp-for="CorreoElectronico">Correo electrónico</label>
                    <input asp-for="CorreoElectronico"
                           type="email"
                           class="form-control form-control-lg"
                           placeholder="correo@ejemplo.com"
                           required
                           autofocus />
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Contrasenna">Contraseña</label>
                    <input asp-for="Contrasenna"
                           type="password"
                           class="form-control form-control-lg"
                           placeholder="Ingrese su contraseña"
                           required />
                </div>

                <button type="submit" class="btn btn-warning btn-lg w-100">
                    Entrar a mi cuenta
                </button>
            </form>

            <div class="login-links">
                <a asp-controller="Auth" asp-action="RegisterBasic">Crear cuenta</a>
                <a asp-controller="Auth" asp-action="ForgotPassword">Olvidé mi contraseña</a>
            </div>
        </div>
    </div>
</section>
